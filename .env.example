# Copy to .env (never commit .env). Values here are placeholders.
# Secrets are read from the environment only and are redacted from logs.

# --- Reddit OAuth (social recorder) -----------------------------------------
# Create a "script" app at https://www.reddit.com/prefs/apps
# User agent format required by Reddit: <platform>:<app id>:<version> (by /u/<username>)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=macos:trade-os-recorder:0.1 (by /u/your_username)

# --- Optional path overrides --------------------------------------------------
# TRADE_STATE_DIR=/absolute/path/var/state      # kill switch, operator token, salts
# TRADE_DATA_DIR=/absolute/path/datasets        # raw and derived datasets
# TRADE_CONFIG_DIR=/absolute/path/config

# --- Broker (not implemented; reserved) --------------------------------------
# BROKER_TYPE=PAPER
